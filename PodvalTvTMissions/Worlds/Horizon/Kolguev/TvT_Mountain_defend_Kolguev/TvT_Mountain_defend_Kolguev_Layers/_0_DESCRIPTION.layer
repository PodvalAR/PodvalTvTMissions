$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "В результате внезапной операции подразделения Вооружённых сил Российской Федерации заняли господствующую высоту «Пик Победы»."\
  "На вершине высоты расположена радиорелейная вышка, используемая для обеспечения устойчивой связи и управления подразделениями в районе операции."\
  "Подразделения ВС РФ закрепились на высоте, развернули огневые позиции и организовали круговую оборону."\
  "Подразделения Вооружённых сил США выдвигаются для проведения штурмовых действий с целью захвата высоты."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "Не нарушайте правила проекта."\
  ""\
  "ВС РФ:"\
  "Удерживать высоту «Пик Победы» "\
  "Не допустить захвата флага "\
  "ВС США:"\
  "Вытеснить противника "\
  "Захватить флаг"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}