  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "Местный бизнесмен Бастович решил кинуть США на определенную информацию, но у него есть друзья в Штабе ВС РФ у которых он попросил защиту. США не понравился такой расклад и они решили устранить Бастовича, чтобы важная информация не досталась никому."
  m_aVisibleForFactions {
