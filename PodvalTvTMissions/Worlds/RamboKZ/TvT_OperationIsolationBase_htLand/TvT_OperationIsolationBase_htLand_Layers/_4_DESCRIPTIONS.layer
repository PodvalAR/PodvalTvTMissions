$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "Описание Миссии"
  m_sTextData "ВС РФ планирует эвакуацию островного гарнизона в связи с понесенными потерями. Главным сдерживающим фактором для отхода сил ВС РФ является дефицит топлива. Задача сил США — уничтожить уцелевшие бензовозы на военной базе, чтобы исключить возможность транспортировки личного состава и техники противника."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила и Задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— На миссии действуют правила для игры на ивентах."\
  "— Запрещено вывозить бензовозы из красных маркеров в которых они появились."\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "— У обороны есть стационарные пулеметы и мешки с песком. "\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ ВС РФ"\
  "— Защитить два бензовоза. (100 очк)"\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ США"\
  "— Уничтожить два бензовоза. (100 очк)"\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
}