$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "Описание Миссии"
  m_sTextData "Бойцы НАПА закрепились в городе Марнивка, ВС РФ хотят выбить их с ключевых позиций в Административных зданиях и на Стройке."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила и Задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ОБЩИЕ ПРАВИЛА "\
  "— На миссии действуют правила для игры на ивентах."\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "— Для захвата нужно двукратное преимущество в триггере в течение 2 мин."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ ВС РФ"\
  "Для победы необходимо выполнить следующие задачи:"\
  "— Захватить \"Административные здания\". (50 очк)"\
  "— Захватить \"Стройку\". (50 очк)"\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ НАПА"\
  "— Не дать захватить \"Административные здания\". (50 очк)"\
  "— Не дать захватить \"Стройка\". (50 очк)"\
  "— Нанести серьезные потери. (100 очк)"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
}