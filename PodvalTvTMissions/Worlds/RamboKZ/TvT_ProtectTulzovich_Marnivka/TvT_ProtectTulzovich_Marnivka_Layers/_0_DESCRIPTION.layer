$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "Описание миссии"
  m_sTextData "После слухов о том что базу Генерала Бисовича атаковали «грязные пиндосы». Генерал Тулзович объявляет полную мобилизацию и начинает экстренное развертывание сил, чтобы выстроить непробиваемую оборону против «грязных пиндосов»."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила и Задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ОБЩИЕ ПРАВИЛА"\
  "— Вертолёту запрещена тактика «Камикадзе»."\
  "— Вертолетами могут управлять только пилоты."\
  ""\
  "ПРАВИЛА США"\
  "— Пилоты только после высадки десанта, могут работать по противнику."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Активу 1-1 запрещено покидать красный маркер."\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "— После убийства Генерал Тулзовича надо опознать через взоимодействе кнопкой F."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ ВС РФ"\
  "— Не дать убить и опознать Ген. Тулзовича."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ США"\
  "— Убить  Ген. Тулзовича."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
}