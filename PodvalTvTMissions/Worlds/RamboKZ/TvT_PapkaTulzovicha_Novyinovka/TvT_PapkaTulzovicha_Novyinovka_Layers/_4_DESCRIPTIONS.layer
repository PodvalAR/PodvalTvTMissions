$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_0_ABOUT" {
  coords 5781.41 109.312 11405.117
  m_sTitle "Описание Миссии"
  m_sTextData "По данным разведки, генерал Тулзович временно покинул свою частную резиденцию. Вооруженные силы США используют этот момент для проведения локальной операции. Цель миссии — проникнуть на объект, обнаружить и изъять папку с засекреченной информацией до возвращения генерала с основными силами."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 "_1_RULES" {
  coords 5777.896 109.312 11407.862
  m_sTitle "Правила и Задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ОБЩИЕ ПРАВИЛА"\
  "— На миссии действуют правила для игры на ивентах."\
  ""\
  "ПРАВИЛА ВС РФ"\
  "— Запрещено взаимодействовать с документами."\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "— Документ нужно принести в одну из зелёных триггеров."\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ ВС РФ"\
  "Для победы необходимо выполнить следующие задачи:"\
  "— Не дать украсть \"Секретный документ\""\
  ""\
  "СПОСОБЫ ПОБЕДЫ ДЛЯ США"\
  "— Украсть \"Секретный документ\""\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
}