$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_1_Rules" {
  coords 4621.515 316.54 1680.88
  m_sTitle "Задачи миссии"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ПРАВИЛА"\
  "— На миссии действуют правила для игры на ивентах."\
  ""\
  "ЗАДАЧИ"\
  "— ВСРФ: Захватить Стройку"\
  "— ION: Удержать Стройку"\
  ""\
  "УСЛОВИЕ ЗАХВАТА"\
  "— Для захвата нужен 2-ух кратный перевес в триггере в тичени 180 сек. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 "_0_About" {
  coords 5828.093 4.731 9838.7
  m_sTitle "О миссии"
  m_sTextData "Городской сектор Al Hadra превратился в зону смерти. Наемники группы ION, закрепившись в многоуровневом недостроенном здании, превратили его в неприступную крепость. Высотка позволяет им контролировать все прилегающие улицы и безнаказанно расстреливать технику ВС РФ на марше. Городские кварталы вокруг стройки превратились в лабиринт из бетона и пыли, где каждый угол может скрывать засаду."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}