$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 "_1_RULES" {
  coords 2330.708 0 1897.149
  m_sTitle "Правила и Задачи"
  m_sTextData "ОБЩИЕ ПРАВИЛА"\
  "— На миссии действуют правила для игры на ивентах."\
  ""\
  "ЗАДАЧИ"\
  "— ВС РФ: Удержать Вертолетную Базу"\
  "— США: Захватить Вертолетную Базу"\
  ""\
  "УСЛОВИЕ ЗАХВАТА"\
  "— Для захвата точек нужно двукратное преимущество в триггере в течение 3 мин."
  m_aVisibleForFactions {
   ""
   "RHS_USAF"
   "RHS_AFRF"
  }
  m_bEmptyFactionVisibility 1
 }
 "_0_ABOUT" {
  coords 2373.245 0 1887.914
  m_sTitle "Описание Миссии"
  m_sTextData "Рассвет принес не свет, а огонь. Внезапный ракетный удар США превратил вертолетный парк в груду горящего металла. Пути к отступлению отрезаны морем, а небо закрыто вражеской авиацией. Оказавшись в ловушке на острове, гарнизон ВС РФ принимает свой последний бой. Сдаваться — не в наших правилах. Удержать базу любой ценой."
  m_aVisibleForFactions {
   ""
   "RHS_USAF"
   "RHS_AFRF"
  }
  m_bEmptyFactionVisibility 1
 }
}