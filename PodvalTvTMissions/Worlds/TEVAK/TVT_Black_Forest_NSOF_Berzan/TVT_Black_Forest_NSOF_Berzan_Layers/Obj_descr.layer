$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 10110.596 0 16108.392
  m_sTitle "Правила и задачи "
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "Правила проведения игры в соответствии с Настоящими правилами указанными на сайте."\
  ""\
  "ЗАДАЧИ армии США: "\
  "1. Взять под полный контроль лесопилку (красный триггер) и фортификационные сооружения (коричневые триггеры), а именно:"\
  "-Бункер №1 (10 очков);"\
  "-Бункер №2 (10 очков);"\
  "-Бункер №3 (10 очков);"\
  "-Бункер №4 (10 очков);"\
  "-Бункер №5 (10 очков);"\
  "-Большой бункер (50 очков)."\
  ""\
  "ЗАДАЧИ армии СССР:"\
  "1. Удержать лесопилку (красный триггер) и фортификационные сооружения (коричневые триггеры)."\
  "-Бункер №1 (10 очков);"\
  "-Бункер №2 (10 очков);"\
  "-Бункер №3 (10 очков);"\
  "-Бункер №4 (10 очков);"\
  "-Бункер №5 (10 очков);"\
  "-Большой бункер (50 очков)."\
  ""\
  "Победа присваиваться стороне набравшей 60 и более очков."\
  ""\
  "ДОПОЛНИТЕЛЬНО:"\
  "1. У миномётчиков США в МАШИНЕ лежит руководство к миномету.   "\
  "  "
  m_aVisibleForFactions {
   "US"
   "USSR"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 10113.558 -0.037 16108.633
  m_sTitle "Ситуация"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "10 августа 1989 года. Северо-западный регион, бывшая Югославия."\
  ""\
  "Несмотря на официальные заявления о «восстановлении лесов», советские силы уже более года контролируют крупный лесозаготовительный комплекс. Под видом мирной хозяйственной деятельности СССР ведёт масштабную вырубку ценных пород дерева и отправляет его морским путём в Китай. Доходы от нелегальной торговли лесом идут на финансирование советского военного присутствия в регионе."\
  ""\
  "Американское командование рассматривает это не только как экологическое преступление, но и как прямую угрозу экономическим интересам США. Контроль над этим лесным районом позволит американцам вытеснить СССР с регионального рынка древесины."\
  ""\
  "Советские войска глубоко укрепились на территории лесопилки, построив развитую систему фортификационных сооружений: блиндажи, траншеи, ДОТы и огневые точки. Лесопилка превратилась в настоящую крепость."
  m_aVisibleForFactions {
   "US"
   "USSR"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
