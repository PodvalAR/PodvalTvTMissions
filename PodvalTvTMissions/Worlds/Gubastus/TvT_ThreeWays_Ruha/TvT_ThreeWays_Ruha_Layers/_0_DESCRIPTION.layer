$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "Разведка ВС РФ доложила, что на одну из баз на границе готовиться нападение со стороны ВС США, на какую из баз нападут - неизвестно."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "ЗАДАЧИ"\
  "— ВС США: доставить командный грузовик на одну из баз и удержать его 30 мин."\
  "— ВС РФ: уничтожить командный грузовик ВС США"\
  ""\
  "* Красная зона — база ВС РФ"\
  "* На каждой базе: грузовик с мешками с песком"\
  "* Базы окружены Hesco блоками — их можно уничтожить."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}