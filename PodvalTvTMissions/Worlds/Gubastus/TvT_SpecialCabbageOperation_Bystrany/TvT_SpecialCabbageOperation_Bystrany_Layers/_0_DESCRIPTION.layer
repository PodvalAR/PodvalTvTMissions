$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "ЧСО при поддержке правительства США начали выращивать ГМО капусту. ВС РФ через котов-разведчиков расположенных по всему городу узнали об этом и почувствовали угрозу экономики, после чего решили начать Специальную Военную Операцию по захвату капусты."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "ПРАВИЛА"\
  "• ЧСО запрещено покидать бирюзовую зону"\
  "• ЧСО и ВС США — союзники"\
  "• Всем можно брать капусту и котов"\
  ""\
  "ЗАДАЧИ"\
  ""\
  "— ВС США:"\
  "  · Вывести в синюю зону не менее 20 кочанов капусты"\
  "  · Забрать 2 котов"\
  ""\
  "— ВС РФ:"\
  "  · Вывести в красную зону не менее 20 кочанов капусты"\
  "  · Забрать 2 котов"\
  ""\
  "— ЧСО:"\
  "  · Не дать ВС РФ вывезти капусту и котов"\
  ""\
  "* Зеленая зона - поле с капустой"\
  "* Коты расположены в городе \"Hnevice\""\
  "* Каждый кот — 25 очков (макс. 2 кота = 50)"\
  "* 20 кочанов капусты — 50 очков (макс.)"\
  "* Если вы вывезли предметы, выложите их на землю и пинганите админа (Y по умолчанию)"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}