$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 4294.413 109.748 5904.232
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ПРАВИЛА:"\
  "- ВС РФ"\
  "1. Командиру ВС РФ запрещено покидать красный тригер;"\
  "2. Командиру ВС РФ разрешено прятаться в домах;"\
  "3. Гарнизону базы запрещено покидать красный тригер в пешем порядке и на транспорте;"\
  "4. Гарнизону базы разрешено перемещать технику на территории красного тригера;"\
  "5. Экипажам БТР разрешено покидать красный тригер;"\
  "6. Снайперская паре разрешено покидать красный тригер;"\
  "7. Вертолётам запрещена тактика \"КАМИКАДЗЕ\"."\
  ""\
  "- ВС США"\
  "1. Пилотам запрещёно использовать вооружение вертолёта до высадки спецназа;"\
  "2. Вертолётам запрещена тактика \"КАМИКАДЗЕ\"."\
  ""\
  "ЗАДАЧИ:"\
  ""\
  "- ВС РФ"\
  "1. Удержать базу (красный тригер);"\
  "2. Не допустить ликвидацую командира ВС РФ."\
  ""\
  "- ВС США"\
  "1. Захватить базу (красный тригер);"\
  "2. Ликвидировать командира ВС РФ."
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 4291.57 109.748 5907.194
  m_sTitle "Обстановка"
  m_sTextData "... Гольф-1... Центру... докладываю обстановку... остров Гогланд, координаты 13-... гарнизон... боевая готовность... две группы... спецназ... патрулируют восточный сектор... противник... на подходе... разведгруппа уже... механизированные... вездеходы... командир... Бережной... "\
  "— Центр вас не слышит, Гольф-1. Повторите. Приём."\
  "— Приём, Центр... повторяю: мы подтверждаем высадку... в 03:47... вертолёты... ... идут на бреющем... русские радары... засекли... но ещё не... у нас есть 15 минут, чтобы... патруль приближается... в 400 метрах... запрашиваю... приказ на..."\
  "— Докладывайте, что у вас? Ещё раз. Приём."\
  "— Гольф-1, подтвердите визуальный контакт с патрулём. Какие силы? Приём."\
  "— Гольф-1, вы меня слышите? Ответьте! Приём."\
  "— ... Центр... мы... связь... прощайте..."\
  "СВЯЗЬ ПРЕРВАНА. ПОСЛЕДНИЙ ПАКЕТ ПРИНЯТ НЕПОЛНОСТЬЮ."\
  "ВРЕМЯ ПОТЕРИ СИГНАЛА: 04:02."\
  "ПРИЧИНА: НЕИЗВЕСТНАЯ."\
  "СТАТУС ГРУППЫ «БУРАН-1»: НЕИЗВЕСТЕН."
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
