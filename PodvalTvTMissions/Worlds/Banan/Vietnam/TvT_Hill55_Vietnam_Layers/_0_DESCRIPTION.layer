$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "1967 год, разгар Вьетнамской войны."\
  "Высота 55, стратегически важная точка на восточном фронте, покрытая густыми джунглями и утесами, которые создают естественные барьеры. Это место стало символом сопротивления и стойкости, так как его заняла армия Вьетконга."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила и задачи"
  m_sTextData "ПРАВИЛА:"\
  ""\
  "1. Вертолетам запрещена тактика \"КАМИКАДЗЕ\";"\
  "2. Вертолетами управлять могут только пилоты."\
  ""\
  "ЗАДАЧИ:"\
  ""\
  "США:"\
  ""\
  "1. Захватить высоту (красный тригер)."\
  ""\
  "Вьетконг:"\
  ""\
  "1. Удержать высоту (красный тригер)."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
