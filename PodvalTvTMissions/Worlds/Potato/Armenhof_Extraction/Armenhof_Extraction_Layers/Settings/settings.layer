$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 2513.493 376.734 592.702
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "												В ночь Хэллоуина аномалия разбросала по всей карте проклятые тыквы. Разведка обеих сторон подтверждает: это не сбой системы, а настоящий клад. Две равные группировки начинают масштабную охоту за урожаем."\
  ""\
  "												Задача: исследовать карту, собирать тыквы и доставлять их на свою базу. Вам попадутся два вида трофеев: маленькие (10 ресурсов) и большие (100 ресурсов). "\
  ""\
  "												Полученные средства тратьте на строительство, бронетехнику или снаряжение прямо в бою."\
  "Битва длится ровно 45 минут. Побеждает команда, которая к концу матча будет иметь больше ресурсов в хранилище."\
  "Совет: Жадность погубит пехоту, а бережливость – оставит без снаряги. Тратьте ресурсы с умом!"\
  ""\
  "												Внимание! Тыквы можно воровать прямо с вражеской базы. Один удачный рейд может перевернуть исход матча!"
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 2513.271 376.717 592.78
  m_sTitle "ВАЖНО!"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "После смерти игроки возрождаются через 10 секунд на своей исходной точке"
  m_aVisibleForFactions {
   "US_AFRF"
   "US_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
}
