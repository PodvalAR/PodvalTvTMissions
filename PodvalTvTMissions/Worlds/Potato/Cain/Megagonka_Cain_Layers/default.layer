$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 7475.513 0 1429.732
  m_sTitle "Обстановка"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "												Официальная легенда: это «спортивно-тактическое мероприятие по развитию навыков экстремального вождения в условиях хаоса»."\
  ""\
  "												Реальность: пока командование жрет блины с икрой, а связисты подменяют спутниковые карты мемами с котами, объявлена Великая Гонка."\
  "	"\
  "												Победитель получит не просто звание «Ас логистики», а банку редчайшей тушенки, ящик самогону (из спирта, добытого из радиаторов БТР) и коллекционные штаны на зависть Реджи"
  m_aVisibleForFactions {
   "CIV"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 7473.555 0 1398.83
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "Правила:"\
  "Гонка происходит вдоль главной дороги вокруг всего острова"\
  ""\
  "Задачи:"\
  "1. ВЫЖИТЬ"\
  "2. Совершить объезд всего острова и вернуться на место старта"
  m_aVisibleForFactions {
   "CIV"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
