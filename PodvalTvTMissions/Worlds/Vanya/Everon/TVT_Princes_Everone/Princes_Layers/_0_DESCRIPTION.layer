$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  coords 0 0 0
  m_sTitle "Лор"
  m_sTextData "В распоряжение разведки США попала информация о том, что силами СССР была захвачена нефтебаза, находящаяся неподалеку от «Якорной бухты», а также, что на этой станции пытаются спрятать бежавшего генерала армии США."\
  ""\
  "ВС США готовят сложнейшую по операции по захвату нефтевышки и устранению «предателя». "\
  ""\
  "Для данной операции выделены огромные человеческие ресурсы и наступательные машины, для возможности пересечь пролив. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 USL {
  coords 0.01 0 -0.001
  m_sTitle "Задачи"
  m_sTextData "Задача для СССР:"\
  ""\
  "- Удержать нефтевышку "\
  "- Не дать убить американского предателя"\
  ""\
  "Задача для США:"\
  ""\
  "- Захватить нефтевышку "\
  "- Убить предателя"
  m_aVisibleForFactions {
   ""
   "rhs_afrf"
   "ses_cdf"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "Условности СССР: "\
  ""\
  "- Предатель не может покидать нефтевышку. "\
  ""\
  "Условности США:"\
  ""\
  "- На карте есть перезарядка для вертолета. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}