$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  coords 0 0 0
  m_sTitle "Лор"
  m_sTextData "После успешной операции «Остров в океане» Утёс был взят под полный контроль силами ВС РФ. "\
  "Главный штаб и основные силы расположились в городе Стрелка, чтобы наладить снабжение и привести в порядок мораль личного состава. "\
  "В данный момент главной уязвимостью является местный аэродром, там остались лишь небольшие боеспособные отделения спецназа для осуществления контроля над воздушной гаванью. "\
  ""\
  "Местные жители, которые проживали в городе Стрелка, были выселены из своих домов и сосланы на серверную часть острова в деревню Каменный. "\
  "Люди, не готовые мириться с подобной ситуацией, собираются устроить восстание против захватчиков. "\
  ""\
  "Вскоре на горизонте люди заметили огоньки приближающейся авиабазы \"Khe Sahn\". "\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 USL {
  coords 0.01 0 -0.001
  m_sTitle "Задачи"
  m_sTextData "Задачи для ВС США:"\
  ""\
  "- Захватить аэродром 50 очк. "\
  "(Также защитывается, если это сделают гражданские) "\
  "- Захватить город 50 очк. "\
  "(Захват города будет осуществляться только при наличии перевеса солдат ВС США) "\
  ""\
  "Задачи для гражданских: "\
  ""\
  "- Захватить аэродром 70 очк. "\
  "(сменить флаг)"\
  "- Помочь США взять город "\
  "(Захват города будет осуществляться только при наличии перевеса солдат ВС США) "\
  ""\
  "Задача для ВС РФ:"\
  ""\
  "- Удержать город 55 очк."\
  "- Удержать аэропорт 45 очк."
  m_aVisibleForFactions {
   ""
   "rhs_afrf"
   "ses_cdf"
   "CIV"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "Условности для ВС США:"\
  ""\
  "- Гражданские и ВС США союзники."\
  "- На территории авиабазы есть перезарядка для вертолета. "\
  ""\
  "Условности для гражданских:"\
  ""\
  "- Гражданские и ВС США союзники."\
  "- На острове можно найти склад с оружием и амуницией."\
  ""\
  "Условности для ВС РФ:"\
  ""\
  "- У всей техники в городе закончился бензин. Отряд топливозаправки в помощь. "\
  "- В триггере есть грузовик с песком. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
GenericEntity : "{E6FC6DD69FA3479F}Prefabs/System/DRG_MissionEndTimerPrefab.et" {
 components {
  DRG_MissionEndTimerComponent "{651B0839B21B3BBF}" {
   m_iMissionTime 3300
  }
 }
