$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  coords 0 0 0
  m_sTitle "Лор"
  m_sTextData "У ВС США появилась информация о расположении главного нефтехранилища, которое находится в порту города Березино. "\
  "Так как основные силы ВС РФ были стянуты в центральную часть острова, охрану данного объекта было поручено осуществлять отрядам ЧДКЗ. "\
  ""\
  "ВС США готовит масштабную наступательную операцию с большим использованием тяжелой техники. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 USL {
  coords 0.01 0 -0.001
  m_sTitle "Задачи"
  m_sTextData "Задача для США:"\
  ""\
  "- Захватить заправочную базу (сменить флаг на главном здании)."\
  "- Уничтожить два бензовоза."\
  ""\
  "Задача для ЧДКЗ:"\
  ""\
  "- Удержать заправочную базу."\
  "- Сохранить два бензовоза."
  m_aVisibleForFactions {
   ""
   "rhs_afrf"
   "ses_cdf"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "- Бензовозы можно прятать только внутри триггера"\
  "- Отрядам 9K135 запрещено перемещаться на своих машинах за триггер."\
  ""\
  "Дополнительно ЧДКЗ:"\
  "- В триггере есть грузовик с песком."\
  "- Некоторые отряды оснащены КОРДом."\
  "- По базе расставлены ZU-23."\
  ""\
  "Дополнительно США: "\
  "- У вертолетов есть перезарядка. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}