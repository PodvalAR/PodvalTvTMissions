$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  coords 0 0 0
  m_sTitle "Лор"
  m_sTextData "Чернорусские силы обороны заняли поселок под названием Горка и обосновали там свой полевой штаб. Часть военных обосновались на востоке поселка в многоквартирных домах, превратив район в неприступную крепость. Вторая часть военнослужащих разбила палаточный лагерь в историческом центре поселка. "\
  ""\
  "Прознав о закреплении врага в данном районе, военнослужащие РФ готовят наступательную операцию с целью захвата поселка и уничтожения передовых технических коммуникаций. "
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 USL {
  coords 0.01 0 -0.001
  m_sTitle "Задачи"
  m_sTextData "Задача для ВС РФ:"\
  ""\
  "- Захватить штаб (сменить флаг)."\
  "- Уничтожить КШМ 2шт. "\
  ""\
  "Задача для ЧСО:"\
  ""\
  "- Удержать штаб."\
  "- Не дать уничтожить КШМ 2шт. "
  m_aVisibleForFactions {
   ""
   "RHS_USAF"
   "Ses_CDF"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "Условности для ЧСО:"\
  ""\
  "-КШМ можно прятать только внутри триггера. "\
  ""\
  "Дополнительно:"\
  "- В триггере есть установки КОРД и АГС с боекомплектами."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}