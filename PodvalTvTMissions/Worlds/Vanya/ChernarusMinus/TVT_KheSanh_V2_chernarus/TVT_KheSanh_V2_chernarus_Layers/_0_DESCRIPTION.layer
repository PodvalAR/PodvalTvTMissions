$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  coords 0 0 0
  m_sTitle "Лор"
  m_sTextData "Легендарный Американский авианосец «Khe Sahn» вынужденно прибыл в порт Черногорска из-за пробоин в корпусе. На борту находятся многочисленные члены экипажа и охрана авианосца, а также техника, предназначенная для текущей войны. "\
  ""\
  "Никто из американских военных не должен покидать корабль, ведь вскоре он должен был отбыть из порта, и во избежание казусов личному составу запретили покидать авиабазу. "\
  ""\
  "Чтобы обеспечить безопасность, на место прибыли местные силы обороны, взяв под контроль портовую часть города. Также в распоряжение сил ЧСО с авианосца был выделен новенький UH-1Y."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 USL {
  coords 0.01 0 -0.001
  m_sTitle "Задачи"
  m_sTextData "Задача для ВС РФ:"\
  ""\
  "- Захватить авианосец"\
  "- Устранить капитана Джека"\
  ""\
  "Задача для ВС США:"\
  ""\
  "- Удержать авианосец"\
  "- Защитить капитана Джека"\
  ""\
  "Задача для ЧСО:"\
  ""\
  "- Не допустить поражение США."
  m_aVisibleForFactions {
   ""
   "rhs_afrf"
   "ses_cdf"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Условности"
  m_sTextData "Условности для США:"\
  ""\
  "- ЗАПРЕЩЕНО ПОКИДАТЬ АВИАНОСЕЦ"\
  "- ЗАПРЕЩЕНО ПЕРЕКРЫВАТЬ ВСЕ 3 ПОДЪЕМА НА КОРАБЛЬ."\
  "- На авианосце есть МНОГО ПЕСКА, укрепите свои позиции. "\
  "- Всю технику можно свободно использовать, но только не покидая авианосец."\
  "- На авиабазе есть ПТУРЫ."\
  ""\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}