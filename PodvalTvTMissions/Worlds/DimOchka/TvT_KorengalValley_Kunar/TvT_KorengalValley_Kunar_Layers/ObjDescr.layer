$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 177.671 306.141 2509.323
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ПРАВИЛА:"\
  "1. Вертолету запрещено использовать тактику \"КАМИКАДЗЕ\";"\
  "2. ION запрещено выходить за зеленый триггер. Разрешено пересекать на границе с синим триггер для вывоза VIPа и выполнении миссии;"\
  "3. Такистанцам запрещено заходить в синий триггер;"\
  "4. Амиру Хан Вогами запрещено как либо сопротивляться приказам ЧВК ION, а также убегать от них. Разрешено только после того, как к вам подойдет повстанец и заберет вас;"\
  "5. Амир Хан Вогами на фризтайме должен взять документы, лежащие перед ним;"\
  "6. Запрещено перевозить VIPа на вертолете."\
  ""\
  "ЗАДАЧИ:"\
  "• ТКР: "\
  " 1. Вернуть местного лидера Амира Хан Вогами (вывезти за зеленый триггер)."\
  ""\
  "• США:"\
  " 1. Помочь ЧВК ION в сопровождении VIPа."\
  ""\
  "• ЧВК ION:"\
  " 1. Вывезти VIPа (в синий триггер)."\
  ""\
  "• CIV:"\
  " 1. Выжить."
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKR"
   "CIV"
   "RHS_ION"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 193.235 306.141 2509.323
  m_sTitle "Обстановка"
  m_sTextData "2019 г."\
  "ЧВК ION во время зачистки одного из убежищ повстанцев случайно обнаружила одного из ключевых лидеров. Сообщив об этом США и заключив выгодную сделку, ION готовится доставить VIPа на военную базу в Баргаме."\
  "Из-за высокой активности инсургентов в регионе наиболее безопасный маршрут проходит через долину Коренгал, контролируемую силами США. Однако повстанцы не намерены сдаваться и готовят операцию по возвращению своего лидера."\
  ""
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKR"
   "CIV"
   "RHS_ION"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
