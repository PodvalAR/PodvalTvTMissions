$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 736.284 137.096 5024.601
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "ПРАВИЛА:"\
  " 1. США запрещено выходить из своих триггеров пока не увидят технику противника."\
  ""\
  "ЗАДАЧИ:"\
  "• США: "\
  " 1. Удержать мост;"\
  " 2. Удержать опорный пункт."\
  ""\
  "• ТКA:"\
  " 1. Захватить мост;"\
  " 2. Захватить опорный пункт."\
  ""\
  "Дополнительно:"\
  "1. У США 2 ПТУРа по 1 снаряду, миномет с SOFLAM, SMAW. "\
  "2. SMAWы без прицела."
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKA"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 736.284 137.096 5024.601
  m_sTitle "Обстановка"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "В мире идет противостояние Такистана и США. "\
  ""\
  "После тяжелых боев за главное шоссе к столице, морпехи США успешно закрепились на нем, однако враг не дремлет и стягивает к точке 3-е Мотострелковое подразделение Такистанской армии \"Пустынные рейдеры\" для ответного удара."\
  ""\
  "К сожалению, из-за надвигающейся песчаной бури, поддержка с воздуха недоступна."
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKA"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 736.284 137.096 5024.601
  m_sTitle "Сообщение ГМу"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "Убрать топливо в технике, которая поставлена автором карты."\
  ""\
  "Техника которая должна быть на миссии:"\
  "1. Приписана к отделениям;"\
  "2. Есть метки на карте."
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKA"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
