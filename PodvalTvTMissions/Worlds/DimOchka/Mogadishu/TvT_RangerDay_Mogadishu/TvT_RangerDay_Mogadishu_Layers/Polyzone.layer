$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 8267.328 57.438 6310.739
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "ПРАВИЛА:"\
  "0. Экипажи вертолетов первым делом должны высадить десант;"\
  "1. Экипажу вертолетов разрешено заводить двигатели на фризтайме, но ЗАПРЕЩЕНО взлетать;"\
  "2. Экипаж вертолетов MH-6 (Диско 1-1) должны высадить Delta Force, а после лететь на аэродром чтобы переодеться в обычных бойцов (метка снаряжение для пилотов) и ждать UH-60 для высадки. ТОЛЬКО В случае если вертолет будет уничтожен, на базе стоит хаммер (можете им воспользоваться) ;"\
  "3. Экипаж UH-60 после высадки рейджеров должен вернуться на аэродром и забрать переодевшихся пилотов для след. высадки;"\
  "4. Запрещено всем кроме пилотов (Диско 1-1) трогать снаряжение для пилотов и хаммер;"\
  "5. Сомалийцам на тойоте ЗАПРЕЩЕНО садиться в машины до конца фриз-тайма."\
  ""\
  "ЗАДАЧИ:"\
  "• США: "\
  " 1. Удержать заложников."\
  ""\
  "• Сомалийцы:"\
  " 1. Захватить заложников (захватить зону)."\
  ""\
  "*UH-60 Реально посадить на дорогу."
  m_aVisibleForFactions {
   "US"
   "Ses_TKR"
   "Ses_CDF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 8267.328 57.438 6310.739
  m_sTitle "Обстановка"
  m_sTextData "1993 г."\
