$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ПРАВИЛА:"\
  "1. Все машины должны двигаться в составе колонны (вкл БМ-21 \"Град\");"\
  "2. Командир колонны управляет колонной - если приказывает остановиться - останавливаются все машины;"\
  "3. В случае гибели командира колонны - принимает управление командир следующей машины;"\
  "4. Не запрещено остановить колонну и отправить отделение пехоты на разведку;"\
  "5. Моджахедам запрещено пересекать зеленую линию;"\
  "6. Колонна должна двигаться строго по красному маршруту."\
  ""\
  "ЗАДАЧИ:"\
  "• СССР: "\
  " 1. Доставить 50% колонны на перевалочный пункт СССР в Jharnok (расчет будет вестись от количества машин выехавших с базы. УАЗ КСа не в счет)."\
  ""\
  "• Моджахеды:"\
  " 1. Уничтожить колонну."\
  ""\
  "Дополнительно:"\
  "1. Внимательно ознакомтесь как одета разведка ГРУ!!! Для избежания ТК - ставьте метки и держите связь;"\
  "2. Можно формировать колонну на фриз-тайме. Машины движутся."
  m_aVisibleForFactions {
   "USSR"
   "RHS_ION"
   "Ses_TKR"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Обстановка"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "Афганистан."\
  "Подразделение 2 роты 345-го ПДП получило задачу переброситься из долины Захран на перевалочный пункт в Джарноке. Помощь в прикрытие колонны должны будут осуществлять работающие в этом регионе отряды ГРУ."\
  ""\
  ""
  m_aVisibleForFactions {
   "USSR"
   "RHS_ION"
   "Ses_TKR"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "ВАЖНО"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "Спаун Разведки ГРУ будет видно лишь на стадии брифинга для СССР."\
  "Зеленой стороне надо быть осторожными и бдительными."
  m_aVisibleForFactions {
   "USSR"
   "RHS_ION"
   "Ses_TKR"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
