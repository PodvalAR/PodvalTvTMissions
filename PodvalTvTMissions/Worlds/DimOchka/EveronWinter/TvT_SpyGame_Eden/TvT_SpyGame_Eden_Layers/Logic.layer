$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 1869.258 8.518 5228.316
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "ПРАВИЛА:"\
  " 1. Запрещено взлетать на фриз-тайме (двигатели запустить можно);"\
  " 2. Французским войска на базе запрещено покидать ее в течении 5 минут после фриз-тайма (сигналом что можно будет пролетающий самолет);"\
  " 3. Запрещено стрелять с гранатометов по зданиям в триггере."\
  ""\
  "ЗАДАЧИ:"\
  "• Франции: "\
  " 1. Не дать найти шпиона;"\
  " 2. Удержать базу."\
  ""\
  "• НОАК:"\
  " 1. Найти китайского агента (синяя зона)."\
  ""\
  "Дополнительно:"\
  "1. Миссия завершается через action меню."
  m_aVisibleForFactions {
   "DIM_PLA"
   "FR"
   "Ses_NAPA"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 1869.258 8.518 5228.316
  m_sTitle "Обстановка"
  m_sTextData "После покушения на китайского министра французским войскам удаётся захватить выжившего участника заговора. Однако Французы отказывается передавать пленного китайской стороне, настаивая на проведении собственного расследования. Ситуация осложняется тем, что китайский агент,  сообщивший о нападении, перестал выходить на связь с французской базы в Леви."\
  ""\
  "Расценив действия французского командования как попытку скрыть причастность к заговору, Пекин направляет к Эверону военно-морскую группировку. На фоне растущей напряжённости французские подразделения усиливают присутствие на острове и продолжают провокационные действия."\
  ""\
  "Морская пехота КНР готовится к высадке на базу Леви, чтобы освободить агента и установить контроль над объектом."
  m_aVisibleForFactions {
   "FR"
   "DIM_PLA"
   "Ses_NAPA"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 1869.258 8.518 5228.316
  m_sTitle "Сообщение ГМу"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "Спустя 5 минут после окончания фриз-тайма надо пустить пролетающий самолет над базой."
  m_aVisibleForFactions {
   "DIM_PLA"
   "FR"
   "Ses_NAPA"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
