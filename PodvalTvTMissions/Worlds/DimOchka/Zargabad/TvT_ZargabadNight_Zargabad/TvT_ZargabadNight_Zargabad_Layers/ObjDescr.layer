$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 177.671 306.141 2509.323
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "ПРАВИЛА:"\
  "1. Хадир Валиву, Мухаммед Залару и отделениям стартующим напротив этих ВИПов ЗАПРЕЩЕНО покидать красный триггер;"\
  "2. Камиль Калару и отделению стартующему напротив него - ЗАПРЕЩЕНО покидать зеленый триггер."\
  ""\
  "ЗАДАЧИ:"\
  "• ТКА: "\
  " 1. Защитить 3 Офицеров."\
  ""\
  "• Израиль:"\
  " 1. Ликвидировать 3 Офицеров."
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKR"
   "Ses_NAPA"
   "Ses_TKA"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 193.235 306.141 2509.323
  m_sTitle "Обстановка"
  m_sTextData "1979 г. Такистан"\
  "В мире идет горячая фаза противостояния Такистана и Израиля. Последним удалось вычислить причастных Такистанских офицеров к расправе над солдатами ЦАХАЛа. Моссад готовит акцию возмездния. "
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKR"
   "Ses_NAPA"
   "Ses_TKA"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 177.671 306.141 2509.323
  m_sTitle "ВАЖНО"
  m_sTextData "У Израиля у некоторых есть британские разгрузки в которых могут не все магазины отображаться - скиньте разгрузку и наденьте обратно."\
  ""
  m_aVisibleForFactions {
   "RHS_USAF"
   "Ses_TKR"
   "UK"
   "Ses_TKA"
   ""
  }
