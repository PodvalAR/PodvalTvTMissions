 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{41DAF7B7061DC0BC}UI/MissionDescription/DescriptionEditable.layout"
  m_sTextData "ПРАВИЛА:"\
  "1. Главе ячейки (КС\ВИП) запрещено покидать бункер."\
  ""\
  "ЗАДАЧИ:"\
  "• РФ: "\
  " 1. Ликвидировать цель."\
  ""\
  "• Ячейка:"\
  " 1. Недопустить ликвидацию командира."\
  ""\
  "ДОПОЛНИТЕЛЬНО:"\
  "1. На тайфунах есть мигалки;"\
  "2. У СОБР есть щиты;"\
  "3. Смерть надо подтвердить."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "Ses_NAPA"
