$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 1869.258 8.518 5228.316
  m_sTitle "Правила и задачи"
  m_sTextData "ПРАВИЛА:"\
  "1. Экипажам вертолетов разрешено заводить двигатели только после конца фриз-тайма;"\
  "2. Экипажам вертолетов разрешено садиться в Кобры только после полной высадки десанта;"\
  "3. В UH-60 должно находиться 2 пилотов (после фриз-тайма на палубе из пилотов никого не должно быть);"\
  "4. Морпехам США на лодках разрешено высаживаться только в желтом триггере;"\
  "5. ВС РФ на электростанции запрещено покидать триггер до прихода подкрепления;"\
  "6. Одна машина подкрепления должна обязательно приехать на электростанцию (Компаса). "\
  ""\
  "ЗАДАЧИ:"\
  "• США: "\
  " 1. Захватить электростанцию;"\
  " 2. Удержать пляж."\
  ""\
  "• ВС РФ:"\
  " 1. Захватить пляж;"\
  " 2. Удержать электростанцию."\
  ""\
  "Побеждает тот, кто быстрее захватит территорию врага."\
  ""\
  "Дополнительно:"\
  "1. У ВС РФ есть грузовики с мешками с песком и 3000 припасов. Разрешено строить только укрепления;"\
  "2. У США есть SMAWы, минометы."
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 1869.258 8.518 5228.316
  m_sTitle "Обстановка"
  m_sTextData "Экспедиционный корпус КМП США совершает высадку на подконтрольную территорию РФ с целью захвата острова"
  m_aVisibleForFactions {
   "RHS_USAF"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
