  coords 3726.272 0 481.413
  m_sTitle "Обстановка"
  m_sTextData "1983 г."\
  "Несколько ДРГ групп СССР совершают вылазку на британский остров Фэйркрофт с целью захвата стратегически важного для операции одного из аэродромов. Без шума взял объект под своей контроль, отряды ГРУ должны удерживать цель в течении 45 минут до прибытия основных сил. Однако, перестав получать обратную связь с охраной Аэродрома, британцы решают отправить дополнительные силы для защиты объект совсем не подозревая уже на наличии нем советских солдат."
  m_aVisibleForFactions {
   "UK"
   "USSR"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
