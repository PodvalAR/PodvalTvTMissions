 }
 {
  coords 11569.529 184.677 6791.432
  m_sTitle "Сюжет"
  m_sTextData "Один из командиров ЧДКЗ, Андрей Лопатин, прибыл на аэродром Балото для встречи с полковником Воробьёвым и переговоров о поставках современного вооружения для дальнейшей борьбы с НАПА. Однако НАПА намерена сорвать сделку и готовит атаку на аэродром."
  m_aVisibleForFactions {
   "Ses_NAPA"
   "Ses_ChDKZ"
   "RHS_AFRF"
   ""
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
