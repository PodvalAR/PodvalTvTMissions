$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Правила и задачи"
  m_sDescriptionLayout "{B6DE04F7CF7A95DA}UI/MissionDescription/DescriptionEditableScrollable.layout"
  m_sTextData "ПРАВИЛА:"\
  "1. США запрещено покидать территорию города (синяя линия). Разрешено покидать разведке;"\
  "2. Разведка США может заезжать в красный триггер (подконтрольная территория РФ);"\
  "3. Запрещено что-либо брать из грузовика с боеприпасами. Он существует только для пополнения БК градов;"\
  "4. РФ для победы нужно захватить центр города и один из кварталов (жилой или пром.зона)."\
  ""\
  "ЗАДАЧИ:"\
  "• РФ: "\
  " 1. Захватить жилой квартал (25);"\
  " 2. Захватить пром. зону (25);"\
  " 3. Захватить центр города (55)."\
  ""\
  "• США:"\
  " 1. Удержать жилой квартал (25);"\
  " 2. Удержать  пром. зону (25);"\
  " 3. Удержать  центр города (55)."\
  ""\
  "ДОПОЛНИТЕЛЬНО:"\
  " 1. У США имеются дроны для разведки."\
  " 2. У обычной пехоты США имеются два хаммера для перевозки ПТУРов. На них можно ездить во время фриз-тайма. Помните о запрете пересекать границу."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Обстановка"
  m_sTextData "Экспедиционный корпус КМП США не собирается просто так сдаваться. Они засели в одном из больших городов Черногорска - Новомитровске. ВС РФ собираются провести совместную операцию ВДВ и МСВ ударив с двух направлений."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
