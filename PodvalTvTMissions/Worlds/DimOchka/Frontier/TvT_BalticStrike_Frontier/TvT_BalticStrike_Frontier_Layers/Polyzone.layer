$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Правила и задачи"
  m_sTextData "ПРАВИЛА:"\
  "1. ВС РФ запрещено пересекать синию линию;"\
  "2. Два отделение ВС РФ должны обязательно находиться в триггере города."\
  ""\
  "ЗАДАЧИ:"\
  "• РФ: "\
  " 1. Удержать город."\
  ""\
  "• США (Латвии):"\
  " 1. Захватить город."\
  ""\
  "Дополнительно:"\
  "1. У ВС РФ имеются ПТУРы, ПТ и ПП мины; "\
  "2. У ВС РФ имеются строительные грузовики - можете строить что угодно (кроме командного пункта), хоть миномет. Ресурсов 3000. На них можно ездить во время фриз-тайма;"\
  "3. Два УРАЛа-4320 с Брезентом без топлива (заправить нельзя) - в них можете забрать ПТ и ПП мины."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   "Ses_CDF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Обстановка"
  m_sTextData "2024 г."\
  "Объединённые силы США и Латвии готовят наступление с целью освобождения населённого пункта на Юго-Востоке Латвии, используемого ВС РФ в качестве перевалочного пункта."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   "Ses_CDF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
