$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Правила и задачи"
  m_sTextData "ПРАВИЛА:"\
  "1. Всем запрещено заходить за желтую линию;"\
  "2. ВС РФ запрещено покидать город (красная линия)."\
  ""\
  "ЗАДАЧИ:"\
  "• РФ: "\
  " 1. Удержать Ж/Д узел;"\
  " 2. Удержать площадь города."\
  ""\
  "• США:"\
  " 1. Захватить Ж/Д узел;"\
  " 2. Захватить площадь города."\
  ""\
  "Дополнительно:"\
  "1. Белые участки карты заполнены лесом, но на карте это никак не отображается. Имейте ввиду;"\
  "2. У ВС РФ имеются КОРДы, ПТУРы, грузовики с мешками с песком и грузовики с минами ПТ и ПП;"\
  "3. На УАЗиках и УРАЛах можно ездить во время фризтайма."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   "Ses_CDF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Обстановка"
  m_sTextData "2018 г."\
  "ВС США продолжают наступление в западной части Зимнитриты и приближаются к стратегически важному для ВС РФ городу Антоньевск. Город является ключевым логистическим узлом: через него проходят важные железнодорожные магистрали, а также расположен выход к побережью. Осознавая его значение, ВС РФ готовят оборону Антоньевска."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   "Ses_CDF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
