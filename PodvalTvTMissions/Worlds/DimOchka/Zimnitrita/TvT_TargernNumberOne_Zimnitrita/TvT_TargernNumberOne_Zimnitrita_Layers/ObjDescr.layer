$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Правила и задачи"
  m_sTextData "ПРАВИЛА:"\
  "1. Вертолету запрещено использовать тактику \"КАМИКАДЗЕ\";"\
  "2. Пилотам невооруженных Литл Бердов разрешено брать вооруженные только после высадки десанта;"\
  "3. ВС РФ (кроме отряда гранатометчиков) запрещено покидать территорию базы (красный триггер). Командиру разрешено прятаться только в домах."\
  ""\
  "ЗАДАЧИ:"\
  "• РФ: "\
  " 1. Защитить командира ВС РФ."\
  ""\
  "• США и CDF:"\
  " 1. Ликвидировать командира ВС РФ (смерть нужно подтвердить)."\
  ""\
  "ДОПОЛНИТЕЛЬНО:"\
  " 1. У ВС РФ имеются ЗУ-23, ПТУРы и КОРДы."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
 {
  coords 6876.31 5.565 6301.583
  m_sTitle "Обстановка"
  m_sTextData "Противостояние ВС РФ и ВС США в западной зоне Зимнитриты привели к поражению последних. Российские войска развернули полевой штаб на военной базе Кромзовы и ожидают прибытия одного из командующих данного направления."\
  "США решают воспользоваться моментом и разрабатывают совместную операцию СПН и Армии по ликвидации командира."
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
 }
}
