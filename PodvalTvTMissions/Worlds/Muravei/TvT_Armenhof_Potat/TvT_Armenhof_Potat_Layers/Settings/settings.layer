$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 2513.493 376.734 592.702
  m_sTitle "Правила и задачи"
  m_sTextData "			В ночь Хэллоуина разведка обеих сторон засекла три заброшенные базы снабжения. Вместо стандартных припасов там обнаружили странные ящики с проклятыми тыквами. Две равные по силам группировки бросаются в бой за этот необычный урожай."\
  ""\
  "			Задача – прорваться к точкам, вскрыть ящики и доставить тыквы на свою базу. Каждая доставленная тыква приносит вашей команде 100 ресурсов. На них можно строить укрепления, вызывать бронетехнику или закупать снаряжение прямо в бою."\
  ""\
  "			Битва длится ровно 45 минут. Побеждает команда, сохранившая больше ресурсов."\
  ""\
  "			Совет: Жадность погубит вашу пехоту, а бережливость – оставит без снаряжения. Тратьте ресурсы с умом!"\
  ""\
  "			Тыквы можно воровать с вражеской базы )))"
  m_aVisibleForFactions {
   "RHS_AFRF"
   "RHS_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 2513.271 376.717 592.78
  m_sTitle "ВАЖНО!"
  m_sTextData "После смерти игроки возрождаются через 10 секунд на своей исходной точке"
  m_aVisibleForFactions {
   "US_AFRF"
   "US_USAF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
}
