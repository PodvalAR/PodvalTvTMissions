$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "Наступили тяжелые времена для Зимнитрита. Длительный конфликт истощил ресурсы региона. Город Андрюханов оказался в мертвой хватке двусторонней атаки. Главными узлами обороны остаются транспортные артерии: американские подразделения давит с запада, зажимая врага у железнодорожного узла, в то время как силы РФ ведут наступление с востока, штурмуя противоположную станцию."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "ПРАВИЛА:"\
  "-Действуют все общие правила проекта."\
  "-Запрещено переодеваться и снимать элементы экипировки."\
  "-Запрещено выходить за красный триггер отмеченный на карте"\
  ""\
  "ЗАДАЧИ:"\
  "ВС РФ:"\
  "-Захватить флаг на западной станции."\
  "США:"\
  "-Захватить флаг на восточной станции."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}