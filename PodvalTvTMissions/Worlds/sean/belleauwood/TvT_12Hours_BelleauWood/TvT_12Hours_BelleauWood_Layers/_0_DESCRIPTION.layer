$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "Передовые подразделения ВС РФ совершили стремительный бросок и захватили ключевой объект в регионе — аэропорт Belleau Wood. Закрепившись на взлетно-посадочной полосе, российские войска начали обустраивать передовую базу дозаправки, чтобы обеспечить снабжение своей авиации и бронетехники."\
  "Для сил США потеря аэропорта означает утрату контроля над воздухом во всем секторе. Командование ВС США отдало приказ на немедленный штурм: необходимо выбить противника с территории объекта и уничтожить топливную инфраструктуру до того, как ВС РФ перебросят сюда основные силы."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "ПРАВИЛА:"\
  "-Действуют все общие правила проекта."\
  "-Запрещено переодеваться и снимать элементы экипировки."\
  "-Взаимодействовать с техникой и прятать бензовозы может только строительный отряд."\
  "-Вывозить бензовозы за пределы синего триггера запрещено"\
  ""\
  "ЗАДАЧИ:"\
  "ВС РФ:"\
  "-Защитить/спрятать технику (70 очков)"\
  "-Удержать аэропорт (30 очков)"\
  "США:"\
  "-Уничтожить бензовозы (70 очков)"\
  "-Захватить аэропорт (30 очков)"\
  ""\
  "ДОПОЛНИТЕЛЬНО"\
  "ВСРФ: ПТРК \"Корнет\", Пулемет \"КОРД\""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}