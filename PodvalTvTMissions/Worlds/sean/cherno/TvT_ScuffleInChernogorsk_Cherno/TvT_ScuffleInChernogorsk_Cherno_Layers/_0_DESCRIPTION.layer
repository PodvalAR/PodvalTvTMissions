$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Лор"
  m_sTextData "Националистические силы НАПА захватили стратегический угольный элеватор в Черноруси. Их цель — быстро вывезти весь оставшийся уголь для продажи на зарубежном теневом рынке, а полученные деньги пустить на финансирование своей экстремистской деятельности. Местные отряды ЧДКЗ истощены, несут потери и не способны самостоятельно отбить объект. Чтобы предотвратить резкое усиление террористов и спасти союзников от разгрома, командование РФ экстренно перебрасывает в сектор элитный взвод спецназа."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила"
  m_sTextData "ПРАВИЛА"\
  ""\
  "-Во время игры действуют все правила проекта Podval."\
  "-Строго запрещено переодевание в форму противоположной фракции."\
  ""\
  "ЗАДАЧИ:"\
  "-ВС РФ (Атака): Выбить силы НАПА с территории угольного элеватора и установить над ним контроль."\
  "-НАПА (Оборона): Отразить наступление РФ и удержать элеватор."\
  ""\
  "ДОПОЛНИТЕЛЬНО:"\
  "На вооружении сил НАПА имеется ПТРК Корнет, ЗУ-23 и пулемет КОРД"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}