$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 ABOUT {
  m_sTitle "Обстановка"
  m_sTextData "Такистан — таинственная и враждебная страна, расположенная в регионе, охваченном конфликтами и политическими интригами. В 2018 году ситуация обострилась до предела."\
  "Отделение ВДВ ВС РФ выполняло боевую операцию. Они направлялись на вертолёте Ми-8, чтобы выполнить важную задачу по укреплению позиций и сбросу вооружения."\
  "Во время выполнения миссии, несмотря на усиленную охрану и меры безопасности, вертолёт был обнаружен и сбит боевиками Такистана — вооружённой группировкой, которая борется за свою независимость и контроль над регионами, находящимися под влиянием иностранных сил."\
  "В результате крушения выжили всего 7 человек, включая экипаж и десантников, оказавшихся в смертельной ситуации в районе боевых действий."\
  "Враг быстро активизировался — боевики Такистана выдвинулись к месту крушения, чтобы добить оставшихся живых и забрать вооружение и боеприпасы, оставшиеся на сбитом вертолёте."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 RULES {
  m_sTitle "Правила и задачи"
  m_sTextData "Для ВС РФ:"\
  ""\
  "Задача: спасти сбитый экипаж вертолёта Ми-8, оказавшийся в опасной зоне."\
  "Цель: обеспечить безопасное спасение живых и эвакуацию экипажа, преодолевая препятствия и вражеские угрозы."\
  ""\
  "Для боевиков Такистана:"\
  ""\
  "Задача: уничтожить экипаж сбитого вертолёта Ми-8."\
  "Цель: помешать спасательной операции, уничтожить оставшихся в живых и захватить вооружение."\
  ""\
  "Условия: Отделению выжившего Ми-8 запрещено покидать красный тригер."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
