$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 8453.938 468.574 1269.933
  m_sTitle "Обстановка"
  m_sTextData "Такистан — таинственная и воинственная страна на Ближнем Востоке, окруженная конфликтами и политической напряженностью."\
  ""\
  "В 2018 году, после ухудшения отношений с соседними странами и усиления межрегиональных конфликтов, Россия решила вмешаться для стабилизации ситуации и защиты своих интересов. В рамках операции на Ближнем Востоке, вооружённые силы РФ были отправлены в Такистан для проведения специальных операций против местных вооружённых групп."\
  "Причина конфликта:Боевики под давлением внутренней нестабильности и региональных конфликтов, начала активно сбивать воздушную технику ВКС РФ, что поставило под угрозу как российских пилотов, так и стратегические интересы России в регионе. В ответ, российские командиры решили провести масштабную зачистку ключевых стратегических объектов — города на востоке страны и аэродромов."
  m_aVisibleForFactions {
   "Ses_TKR"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 {
  coords 8447.157 469.564 1255.298
  m_sTitle "Правила и задачи"
  m_sTextData "Для ВС РФ:"\
  ""\
  "Цель: захватить ключевой аэродром и город, уничтожить регулярные части армии Такистана."\
  "Запрещено использование камикадзе-атак воздушной техникой."\
  ""\
  ""\
  "Для Боевиков:"\
  ""\
  "Цель: удержать аэродром и город в своих руках любой ценой."
  m_aVisibleForFactions {
   "Ses_TKR"
   "RHS_AFRF"
   ""
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
}
